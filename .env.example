# Look Through — environment template. Copy to .env (never commit .env) and fill in your own values.
# Only variables actually read by the code are listed. Names starting with VITE_ are bundled into the
# browser and are PUBLIC: never put secrets in them.

# ── Frontend (public, exposed to the browser) ──────────────────────────────
# Base path of the API. Leave as /api for Vercel and for `npm run dev` (Vite bridges /api/* locally).
VITE_API_BASE_URL=/api
# Shown/used as app version metadata.
VITE_APP_VERSION=0.0.0
# Your Neon Auth base URL, e.g. https://ep-xxxx.neonauth.<region>.aws.neon.tech/<db>/auth
# If empty, the browser auth client is disabled and every user stays a guest.
VITE_NEON_AUTH_URL=

# ── Server only (never expose) ─────────────────────────────────────────────
# REQUIRED. Neon PostgreSQL connection string. Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# The server also accepts POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING or NEON_DATABASE_URL.
DATABASE_URL=
# REQUIRED for authenticated API calls. Same Neon Auth base URL as above; used server-side to verify the
# session cookie via <base>/get-session. Falls back to VITE_NEON_AUTH_URL, NEON_AUTH_URL or BETTER_AUTH_URL.
NEON_AUTH_BASE_URL=
# Optional. debug | info | warn | error (default info).
LOG_LEVEL=info
