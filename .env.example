# Client-safe configuration
VITE_API_BASE_URL=/api
VITE_APP_VERSION=0.0.0
VITE_NEON_AUTH_URL=

# Server-only configuration; never expose these through VITE_ variables.
DATABASE_URL=
NEON_AUTH_BASE_URL=
LOG_LEVEL=info

# Required when auth is enabled; provision through the deployment environment.
BETTER_AUTH_SECRET=
